# build output
/target/
/dist/
/build/
node_modules/
# (but the Companion web app's fonts and icons, which its build keeps under that name:
# tools/companion-web.mjs)
!/assets/companion-web/assets/node_modules/

# local settings and secrets
.env
.env.*
*.local

# editors and systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# fonts we may not ship
*Switzer*

# the Tauri app's generated schemas
/app/gen/

# what the setup's checks leave in the fixtures
/fixtures/**/Plugins/
/fixtures/**/.omsihub-write-test

# other cargo target folders (a second build beside the first)
/target-*/
